# SPDX-License-Identifier: GPL-2.0-only
maintainer="fossdd <fossdd@pwned.life>"
pkgname=${APK_PKGNAME:-linux-upstream}
pkgver=${KERNELVERSION/-/_}
pkgrel=$KBUILD_REVISION
pkgdesc="Linux upstream kernel"
url="https://kernel.org"
arch="$CARCH"
license="GPL-2.0-only"
makedepends="
	bash
	bc
	bison
	findutils
	flex
	git
	openssl-dev
	perl
	python3
	zstd
	"
builddir="$startdir"/../..
options="!strip !check !tracedeps"
repo="linux"

_extrapackages=${APK_EXTRAPACKAGES-headers api-headers debug}
for pkg in $_extrapackages; do
	subpackages="$subpackages $pkgname-$pkg"
done

export MAKEFLAGS="$KBUILD_MAKEFLAGS"

build() {
	msg "Building $pkgdesc kernel"
	$MAKE \
		KERNELRELEASE="$KERNELRELEASE" \
		KBUILD_BUILD_VERSION="$pkgrel"
}

package() {
	local moddir="$pkgdir"/usr/$MODLIB

	msg "Installing boot image..."
	install -Dm644 "$($MAKE -s image_name)" "$moddir"/vmlinuz

	msg "Installing modules..."
	$MAKE modules_install \
		INSTALL_MOD_PATH="$pkgdir"/usr \
		INSTALL_MOD_STRIP=1 \
		DEPMOD=true

	if [ -d "$srctree"/arch/$SRCARCH/boot/dts ]; then
		msg "Installing dtbs..."
		$MAKE INSTALL_DTBS_PATH="$moddir"/dtb dtbs_install
	fi

	# remove build link, will be part of -headers package
	rm -f "$moddir/build"
}

headers() {
	pkgdesc="Headers and scripts for building modules for the $pkgdesc kernel"

	local modbuilddir="$subpkgdir"/usr/$MODLIB/build

	if grep -q CONFIG_MODULES=y "$builddir"/include/config/auto.conf; then
		echo "Installing build files..."
		"$srctree"/scripts/package/install-extmod-build "$modbuilddir"
	fi

	msg "Installing System.map and config..."
	mkdir -p "$modbuilddir"
	cp "$builddir"/System.map "$modbuilddir"/System.map
	cp "$builddir"/.config "$modbuilddir"/.config

	msg "Adding symlink..."
	mkdir -p "$subpkgdir"/usr/src
	ln -sr "$modbuilddir" "$subpkgdir"/usr/src/$pkgname
}

api-headers() {
	pkgdesc="Kernel headers sanitized for use in userspace"

	$MAKE headers_install \
	   INSTALL_HDR_PATH="$subpkgdir"/usr
}

debug() {
	pkgdesc="Non-stripped vmlinux file for the $pkgdesc kernel"

	local debugdir="$subpkgdir"/usr/src/debug/$pkgname
	local modbuilddir="$subpkgdir"/usr/$MODLIB/build

	install -Dm644 "$builddir"/vmlinux -t "$debugdir"
	mkdir -p "$modbuilddir"
	ln -sr "$debugdir"/vmlinux "$modbuilddir"/vmlinux
}
